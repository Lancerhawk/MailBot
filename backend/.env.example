NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Rate Limiting Store: 'memory' (default, single instance) or 'redis' (horizontally scalable)
RATE_LIMIT_STORE="memory"
REDIS_URL="redis://127.0.0.1:6379"

# Authentication & OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
SESSION_SECRET="generate-a-secure-random-string-at-least-32-chars"
ENCRYPTION_KEY="generate-a-64-character-hex-string-here"

GROQ_API_KEY="your-groq-api-key"
GMAIL_PUBSUB_TOPIC="your-gmail-pubsub-topic"

# Gmail Pub/Sub Webhook Security (OIDC Authentication)
GMAIL_WEBHOOK_REQUIRE_OIDC="true"
GMAIL_WEBHOOK_AUDIENCE="http://localhost:5000/api/v1/gmail/webhook"
GMAIL_WEBHOOK_SERVICE_ACCOUNT_EMAIL="pubsub-push@your-gcp-project.iam.gserviceaccount.com"

AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-access-key"
AWS_REGION="region"
AWS_S3_BUCKET="name-of-the-bucket"
GROQ_CONCURRENCY_LIMIT=2


EMBEDDING_WORKERS=1
EMBEDDING_BATCH_SIZE=16
MODEL_CACHE_DIRECTORY=.cache/models
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_SIZE_MB=50
MAX_CHUNKS_PER_DOCUMENT=2000
PROCESSING_JOB_TIMEOUT=600000
METADATA_CONFIDENCE_THRESHOLD="0.12"

# Standalone Worker Configuration
# WORKER_MODE: "local" (default, runs workers inside API server) | "remote" (runs workers via standalone npm run start:worker)
WORKER_MODE="local"
INTERNAL_WORKER_SECRET="internal-worker-secret-dev"
API_SERVER_URL="http://localhost:5000"