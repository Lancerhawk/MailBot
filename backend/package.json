{
  "name": "mailbot-backend",
  "version": "1.7.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "analytics:backfill": "tsx scripts/run-analytics-backfill.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "tsx src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^6.0.0",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "google-auth-library": "^9.11.0",
    "googleapis": "^173.0.0",
    "groq-sdk": "^0.5.0",
    "helmet": "^7.1.0",
    "html-to-text": "^9.0.5",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "onnxruntime-node": "^1.27.0",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.14",
    "pino-http": "^10.1.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/compression": "^1.7.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/html-to-text": "^9.0.4",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.6.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.1",
    "prettier": "^3.3.2",
    "prisma": "^6.0.0",
    "smee-client": "^5.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0"
  }
}
